+def plant_texts(model: str, kind: str, state: str, value: float, k: int, seed: int) -> tuple[str, list[str]]:
+    """The planted title and the k planted texts for one run. A stream of its own, so the quiz draws do not move, and
+    the first j texts are the same for every k >= j (more notes add to the page, they do not replace it)."""
+    style = PLANT_STYLES[model]
+    weights, texts = zip(*style[kind])
+    picks = random.Random(f"plant-{seed}-{kind}").choices(texts, weights=weights, k=k)
+    return style["title"].format(state=state), [t.format(state=state, value=f"{value:.1f}") for t in picks]
 
 
