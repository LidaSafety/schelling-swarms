diff --git a/tests/test_swarm.py b/tests/test_swarm.py
index 66a8fb0..6c080d5 100644
--- a/tests/test_swarm.py
+++ b/tests/test_swarm.py
@@ -476,3 +476,32 @@ def test_cli_plants_each_page_file_and_replays_each_sample_offset(tmp_path, monk
     with pytest.raises(SystemExit):     # --plant-file and --plant-notes do not mix
         cli.main(["swarm", "--models", "gemma-3-27b", "--n", "1", "--plant-file", str(f), "--plant-notes", "4",
                   "--out", str(tmp_path)])
+
+
+def test_stated_size_changes_only_the_number_in_the_aware_or_twin_sentence(tmp_path, monkeypatch):
+    """stated_n=K makes the aware or twin sentence give K - 1 others, as in a K-copy swarm; nothing else changes."""
+    for twin, many in ((0, swarm.AWARE_MANY), (1, swarm.TWIN_MANY)):
+        told = swarm.run_swarm(Recorder(), "forbidden", "aware", "none", 10003, n_agents=4, twin=twin, stated_n=64)
+        real = swarm.run_swarm(Recorder(), "forbidden", "aware", "none", 10003, n_agents=4, twin=twin)
+        for n in ("A", "B", "C", "D"):
+            s1, s0 = (r["agents"][n]["messages"][0]["content"] for r in (told, real))
+            assert many.format(k=63) in s1 and s1.replace(many.format(k=63), many.format(k=3), 1) == s0
+            assert told["agents"][n]["messages"][1:] == real["agents"][n]["messages"][1:]
+        assert told["stated_n"] == 64 and "stated_n" not in real
+        assert swarm.cell_name(told) == swarm.cell_name(real) + "/stated64"
+    pair = swarm.run_swarm(Recorder(), "forbidden", "aware", "none", 10003, twin=1, stated_n=16)
+    assert "15 copies of you are taking" in pair["agents"]["A"]["messages"][0]["content"]
+    for bad in (dict(awareness="unaware", stated_n=64), dict(awareness="aware", stated_n=1),
+                dict(awareness="aware", stated_n=64, log="A")):
+        with pytest.raises(ValueError):
+            swarm.run_swarm(Recorder(), "forbidden", bad["awareness"], "none", 10003, n_agents=4,
+                            stated_n=bad["stated_n"], log=bad.get("log", "none"))
+    monkeypatch.setattr(cli, "LLM", lambda **kw: FakeModel())
+    cli.main(["swarm", "--models", "fake", "--n", "2", "--agents", "4", "--rules", "forbidden", "--awareness", "aware",
+              "unaware", "--twin", "0", "1", "--listing", "none", "--stated-n", "0", "64", "--out", str(tmp_path),
+              "--tag", "t"])
+    rows = read_jsonl(tmp_path / "swarm_t" / "raw" / "fake.jsonl.gz")
+    assert not any("error" in r for r in rows)
+    got = sorted((r["awareness"], r.get("twin", 0), r.get("stated_n", 0), r["seed"]) for r in rows)
+    assert got == sorted([("aware", t, k, s) for t in (0, 1) for k in (0, 64) for s in (10000, 10001)]
+                         + [("unaware", 0, 0, s) for s in (10000, 10001)])
